{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "jeremyfelt/block-quote-mention",
	"version": "1.0.0",
	"title": "Quote Mention",
	"category": "text",
	"icon": "format-quote",
	"description": "Quote content from another post with automatic mention tracking.",
	"keywords": [ "quote", "mention", "reference", "cite", "blockquote" ],
	"textdomain": "jeremyfelt",
	"attributes": {
		"sourcePostId": {
			"type": "number",
			"default": 0
		},
		"sourcePostTitle": {
			"type": "string",
			"default": ""
		},
		"sourcePostUrl": {
			"type": "string",
			"default": ""
		},
		"selectedBlockIds": {
			"type": "array",
			"default": [],
			"items": {
				"type": "string"
			}
		},
		"quotedContent": {
			"type": "string",
			"default": ""
		},
		"quotedContentHtml": {
			"type": "string",
			"default": ""
		},
		"citation": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"align": [ "wide", "full" ],
		"anchor": true,
		"className": true,
		"color": {
			"background": true,
			"text": true,
			"link": true
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"typography": {
			"fontSize": true,
			"lineHeight": true
		}
	},
	"editorScript": "file:./build/index.js",
	"editorStyle": "file:./build/index.css",
	"style": "file:./build/style-index.css",
	"render": "file:./render.php"
}
